services:
  dockge:
    image: louislam/dockge:1
    restart: unless-stopped
    ports:
      - "{{ dockge_bind_ip }}:{{ dockge_port }}:5001"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./data:/app/data
      - /opt/stacks:/opt/stacks
    environment:
      - DOCKGE_STACKS_DIR=/opt/stacks
